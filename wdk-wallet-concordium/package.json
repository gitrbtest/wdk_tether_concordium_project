{
  "name": "@tetherto/wdk-wallet-concordium",
  "version": "1.0.0-beta.1",
  "description": "WDK wallet module for the Concordium blockchain: account derivation, native CCD, PLT + CIS-2 tokens, sponsored transactions, dev/testnet onboarding, and seed-based account recovery.",
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "src", "types", "README.md", "LICENSE"],
  "scripts": {
    "example": "node example.mjs",
    "example:send": "node example-send.mjs",
    "example:verify": "node example-verify.mjs",
    "onboard:request": "node example-onboard.mjs request",
    "onboard:create": "node example-onboard.mjs create",
    "example:token": "node example-token.mjs",
    "example:sponsored": "node example-sponsored.mjs",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:integration": "node --test \"test/integration/*.test.mjs\"",
    "test:all": "node --test \"test/unit/*.test.mjs\" \"test/integration/*.test.mjs\""
  },
  "keywords": ["wdk", "wallet", "concordium", "ccd", "multi-chain", "tether"],
  "author": "Concordium",
  "license": "Apache-2.0",
  "dependencies": {
    "@tetherto/wdk-wallet": "1.0.0-beta.15",
    "@concordium/web-sdk": "12.0.2",
    "@grpc/grpc-js": "1.14.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
